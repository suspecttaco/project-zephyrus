{
  "name": "project-zephyrus",
  "version": "1.0.0",
  "description": "Backend for personal and shared finances for families and roommates",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "start:cluster": "node --env-file=.env dist/cluster.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "cluster": "tsx --env-file=.env src/cluster.js",
    "typecheck": "tsc --noEmit",
    "loadtest": "autocannon -d 10 -c 50 http://localhost:3000/api/users",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suspecttaco/project-zephyrus.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/suspecttaco/project-zephyrus/issues"
  },
  "homepage": "https://github.com/suspecttaco/project-zephyrus#readme",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "autocannon": "^2.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
