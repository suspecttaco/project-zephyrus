{
  "name": "finanzas-personales-compartidas",
  "version": "1.0.0",
  "description": "Backend for personal and shared finances for families and roommates",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "start:cluster": "node --env-file=.env dist/cluster.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "cluster": "tsx --env-file=.env src/cluster.js",
    "typecheck": "tsc --noEmit",
    "loadtest": "autocannon -d 10 -c 50 http://localhost:3000/api/users",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesarrolloBackend-2026-402/23122722.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/DesarrolloBackend-2026-402/23122722/issues"
  },
  "homepage": "https://github.com/DesarrolloBackend-2026-402/23122722#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "autocannon": "^2.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  }
}
