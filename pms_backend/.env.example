# Copia este archivo a .env y completa los valores (el .env real no se sube a git).

# Correo (Gmail). SMTP_PASS debe ser una contraseña de aplicación de Google, no la contraseña de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Adjuntos de tareas (capítulo 11): local (disco), s3 (LocalStack) o memory (pruebas)
# STORAGE_PROVIDER=local
# LOCAL_UPLOAD_DIR=./uploads
# AWS_S3_BUCKET=pms-attachments
# AWS_ENDPOINT_URL=http://127.0.0.1:4566   # usa 127.0.0.1, no localhost: con podman localhost (IPv6) corta la conexión
# SMS_API_URL=            # pasarela de SMS opcional; sin ella el SMS se simula en el log
# SMS_API_TOKEN=
# ENCRYPTION_KEY=         # 64 caracteres hexadecimales para el Decorator de cifrado

# Servicio de actividad (capítulo 14)
# ACTIVITY_URL=http://127.0.0.1:4100
# ACTIVITY_PORT=4100
# ACTIVITY_DATA_DIR=./data/activity
# ACTIVITY_TOKEN=

# Máximo de tareas en progreso por proyecto (capítulo 15)
# MAX_IN_PROGRESS_PER_PROJECT=5

# Mensajería (capítulo 16): solo se activa si está definida
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Seguridad de Express (capítulo 3)
# RATE_LIMIT_MAX=1000            # peticiones por IP y ventana a /api/
# RATE_LIMIT_WINDOW_MS=900000    # 15 minutos
# LOGIN_RATE_LIMIT_MAX=10        # intentos fallidos de login/recuperación por IP y ventana
# RATE_LIMIT_DISABLED=true       # solo para pruebas

# Análisis de riesgo (capítulo 18)
# ANALYTICS_THREADS=2
# ANALYTICS_TIMEOUT_MS=15000

# Opcionales
# JWT_SECRET=cambia-esta-clave
# REDIS_URL=redis://127.0.0.1:6379
# PORT=3000
# WEB_CONCURRENCY=2
# DB_HOST= DB_PORT= DB_USER= DB_PASSWORD= DB_NAME=   (sobrescriben server_config.json)

# LocalStack (S3/EC2 locales para el capítulo 10). Token gratuito (plan Hobby) desde el panel de LocalStack.
# LOCALSTACK_AUTH_TOKEN=
